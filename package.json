{
  "name": "@forjio/huudis-node",
  "version": "0.5.0",
  "description": "Official Node.js SDK for Huudis \u2014 email/social/MFA, fine-grained authorization, webhook signature verification, and full admin API (IAM, workspaces, end-users, billing, webhook subscriptions). Powered by @forjio/sdk's device-flow auth + http-client.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@forjio/sdk": "^0.5.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "auth",
    "oidc",
    "openid-connect",
    "huudis",
    "forjio",
    "iam",
    "jwt"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hachimi-cat/huudis-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hachimi-cat/huudis-node.git"
  },
  "bugs": {
    "url": "https://github.com/hachimi-cat/huudis-node/issues"
  }
}
